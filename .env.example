# ===== Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env =====
# --- Hồ sơ triển khai ---
DEPLOY_PROFILE=pilot                     # demo | pilot | production (production: từ chối khởi động nếu còn BLOCKER – xem docs/DEPLOYMENT.md)
CORE_ADAPTER=mock                        # mock = dữ liệu mô phỏng; production phải là adapter core banking thật
ENSEMBLE_MODE=                           # active | shadow (trống: demo=active, pilot/production=shadow) – mô hình bot–người và boosting giám sát
FACE_AI_PROVIDER=demo                    # demo = embedding giả lập; production phải là nhà cung cấp Face-AI thật (đạt PAD)
HUMAN_LLM_MODE=off                       # không gọi LLM trên đường đi thời gian thực của người dùng
ALLOW_SQLITE_PRODUCTION=0                # chỉ đặt 1 cho pilot một máy

# --- Bắt buộc ở production ---
PRICING_ENVIRONMENT=production          # demo | production (production: Test Lab tắt, bắt buộc secret + Redis)
SECRET_KEY=                              # >= 32 ký tự ngẫu nhiên:  python -c "import secrets;print(secrets.token_urlsafe(48))"
API_SIGNING_SECRET=                      # >= 32 ký tự ngẫu nhiên, khác SECRET_KEY
CARD_VAULT_KEY=                          # khóa mã hóa vault token thẻ (ngẫu nhiên, giữ bí mật, sao lưu an toàn)
REDIS_URL=redis://redis:6379/0           # bắt buộc khi chạy nhiều worker/nhiều máy (rate-limit, phiên, chống replay)
SESSION_COOKIE_SECURE=1                  # 1 khi chạy sau HTTPS
TRUSTED_PROXY=1                          # 1 khi chạy sau reverse proxy/nginx/Render (đọc IP thật từ X-Forwarded-For)

# --- Chỉ demo ---
DEMO_PASSWORD=                           # mật khẩu các tài khoản demo
ALLOW_MEMORY_STORE=0                     # 1 = cho phép store trong RAM khi không có Redis (CHỈ demo, 1 worker)
AGENTMON_LAB=0                           # 1 = bật Test Lab ở production (không khuyến nghị)

# --- AI Agent Monitor ---
AGENTMON_DB=/app/data/agentmon.db        # đường dẫn SQLite (production: nên chuyển sang PostgreSQL/Oracle – xem docs/DEPLOYMENT.md)
AGENTMON_MODEL_DIR=/app/models           # thư mục mô hình + MANIFEST.json
AGENTMON_MODEL_ARCHIVE=1                 # 1 = lưu bản sao mô hình theo version để kiểm toán/tái lập
LLM_PROVIDER=mock                        # mock | groq
LLM_MODE=gray                            # gray (chỉ vùng xám) | always | off
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# --- Anti-Bot / vận hành ---
MFA_REQUIRED_ROLES=HQ,CN_ADMIN
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
ALERT_WEBHOOK_URL=
AUDIT_LOG_FILE=/app/logs/audit.jsonl
TXN_LOG_FILE=/app/logs/txn.jsonl
WEB_CONCURRENCY=2                        # số worker gunicorn (>1 cần REDIS_URL)
PORT=5000
